{
  "id": "demo_tap_swipe",
  "name": "示例：桌面滑动",
  "version": 1,
  "loop": 1,
  "steps": [
    { "action": "log", "message": "回到桌面" },
    { "action": "home" },
    { "action": "wait", "ms": 1200 },
    { "action": "log", "message": "上滑" },
    { "action": "swipe", "x1": 0.5, "y1": 0.78, "x2": 0.5, "y2": 0.28, "duration_ms": 400 },
    { "action": "wait", "ms": 800 },
    { "action": "tap", "x": 0.5, "y": 0.5 },
    { "action": "log", "message": "演示完成" }
  ]
}
