{
  "id": "open_settings",
  "name": "打开系统设置",
  "version": 1,
  "loop": 1,
  "steps": [
    { "action": "log", "message": "启动系统设置" },
    { "action": "launch", "package": "com.android.settings" },
    { "action": "wait", "ms": 2000 },
    { "action": "wait_for_text", "text": "设置", "timeout_ms": 8000 },
    { "action": "log", "message": "设置页已打开" }
  ]
}
