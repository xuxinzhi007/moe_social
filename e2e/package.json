{
  "name": "moe-social-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Moe Social Flutter Web 自动化测试",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test specs/smoke.spec.ts",
    "test:e2e": "playwright test specs/e2e.spec.ts",
    "test:headed": "playwright test --headed",
    "test:trace": "playwright test --trace on",
    "install": "playwright install chromium",
    "show-report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0"
  }
}
