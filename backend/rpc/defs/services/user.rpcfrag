// FS-8b: user 域 RPC（编入 service Super）
  rpc Register(RegisterReq) returns (RegisterResp);
  rpc Login(LoginReq) returns (LoginResp);
  rpc GetUserInfo(GetUserInfoReq) returns (GetUserInfoResp);
  rpc GetUser(GetUserReq) returns (GetUserResp);
  rpc GetUserByEmail(GetUserByEmailReq) returns (GetUserByEmailResp);
  rpc UpdateUserInfo(UpdateUserInfoReq) returns (UpdateUserInfoResp);
  rpc UpdateUserPassword(UpdateUserPasswordReq) returns (UpdateUserPasswordResp);
  rpc ResetPassword(ResetPasswordReq) returns (ResetPasswordResp);
  rpc DeleteUser(DeleteUserReq) returns (DeleteUserResp);
  rpc GetUsers(GetUsersReq) returns (GetUsersResp);
  rpc GetUserCount(GetUserCountReq) returns (GetUserCountResp);
  rpc BindFeishu(BindFeishuReq) returns (BindFeishuResp);
  rpc UnbindFeishu(UnbindFeishuReq) returns (UnbindFeishuResp);
  rpc SendFeishuTestCard(SendFeishuTestCardReq) returns (SendFeishuTestCardResp);
  rpc FeishuAuthorizeURL(FeishuAuthorizeURLReq) returns (FeishuAuthorizeURLResp);
  rpc FeishuLogin(FeishuLoginReq) returns (FeishuLoginResp);
  rpc WechatAuthorizeURL(WechatAuthorizeURLReq) returns (WechatAuthorizeURLResp);
  rpc WechatLogin(WechatLoginReq) returns (WechatLoginResp);
  rpc GetUserMemories(GetUserMemoriesReq) returns (GetUserMemoriesResp);
  rpc SyncUserDevice(SyncUserDeviceReq) returns (SyncUserDeviceResp);
  rpc ListUserDevices(ListUserDevicesReq) returns (ListUserDevicesResp);
  rpc GetNotifications(GetNotificationsReq) returns (GetNotificationsResp);
  rpc GetUnreadCount(GetUnreadCountReq) returns (GetUnreadCountResp);
  rpc ReadNotification(ReadNotificationReq) returns (ReadNotificationResp);
  rpc ReadAllNotifications(ReadAllNotificationsReq) returns (ReadAllNotificationsResp);
  rpc CreateNotification(CreateNotificationReq) returns (CreateNotificationResp);
  rpc SendPrivateMessage(SendPrivateMessageReq) returns (SendPrivateMessageResp);
  rpc ListPrivateMessages(ListPrivateMessagesReq) returns (ListPrivateMessagesResp);
  rpc ListPrivateConversations(ListPrivateConversationsReq) returns (ListPrivateConversationsResp);
  rpc Recharge(RechargeReq) returns (RechargeResp);
  rpc GetTransactions(GetTransactionsReq) returns (GetTransactionsResp);
  rpc GetTransaction(GetTransactionReq) returns (GetTransactionResp);
  rpc FollowUser(FollowUserReq) returns (FollowUserResp);
  rpc UnfollowUser(UnfollowUserReq) returns (FollowUserResp);
  rpc GetFollowings(GetFollowingsReq) returns (GetFollowingsResp);
  rpc GetFollowers(GetFollowersReq) returns (GetFollowersResp);
  rpc CheckFollow(CheckFollowReq) returns (CheckFollowResp);
  rpc SendFriendRequest(SendFriendRequestReq) returns (SendFriendRequestResp);
  rpc ListIncomingFriendRequests(ListIncomingFriendRequestsReq) returns (ListIncomingFriendRequestsResp);
  rpc ListOutgoingFriendRequests(ListOutgoingFriendRequestsReq) returns (ListOutgoingFriendRequestsResp);
  rpc AcceptFriendRequest(AcceptFriendRequestReq) returns (AcceptFriendRequestResp);
  rpc RejectFriendRequest(RejectFriendRequestReq) returns (RejectFriendRequestResp);
  rpc ListFriends(ListFriendsReq) returns (ListFriendsResp);
  rpc GetFriendRelation(GetFriendRelationReq) returns (GetFriendRelationResp);
  rpc GetUserAvatar(GetUserAvatarReq) returns (GetUserAvatarResp);
  rpc UpdateUserAvatar(UpdateUserAvatarReq) returns (UpdateUserAvatarResp);
  rpc GetUserUnlockedAchievements(GetUserUnlockedAchievementsReq) returns (GetUserUnlockedAchievementsResp);
