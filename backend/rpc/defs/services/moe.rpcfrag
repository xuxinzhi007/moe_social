  rpc AdminCurateMoeBrain(AdminCurateMoeBrainReq) returns (AdminCurateMoeBrainResp);
  rpc AdminGetMoeBrainPipeline(AdminGetMoeBrainPipelineReq) returns (AdminGetMoeBrainPipelineResp);
  rpc AdminGetMoeToolStats(AdminGetMoeToolStatsReq) returns (AdminGetMoeToolStatsResp);
  rpc AdminListMoeToolCalls(AdminListMoeToolCallsReq) returns (AdminListMoeToolCallsResp);
  rpc MoeExecuteTool(MoeExecuteToolReq) returns (MoeExecuteToolResp);
  rpc MoeSearchPosts(MoeSearchPostsReq) returns (MoeSearchPostsResp);
