// LLM 聊天相关结构
type LlmMessage {
	Role    string `json:"role"`
	Content string `json:"content"`
}

type LlmChatReq {
	Model               string       `json:"model"`
	Messages            []LlmMessage `json:"messages"`
	SessionId           string       `json:"session_id,optional"`
	SourceMsgId         string       `json:"source_msg_id,optional"`
	ClientMemoryApplied bool         `json:"client_memory_applied,optional"`
	Stream              bool         `json:"stream,optional"`
	Temperature         float64      `json:"temperature,optional"`
	TopP                float64      `json:"top_p,optional"`
	MaxTokens           int          `json:"max_tokens,optional"`
	RepeatPenalty       float64      `json:"repeat_penalty,optional"`
}

type LlmChatResp {
	BaseResp
	Content        string  `json:"content"`
	RemainingRatio float64 `json:"remaining_ratio"`
	Summarized     bool    `json:"summarized"`
}

type LlmModelsResp {
	BaseResp
	Models []string `json:"models"`
}

type LlmCreateAgentReq {
	Name         string `json:"name"`
	BaseModel    string `json:"base_model"`
	SystemPrompt string `json:"system_prompt"`
}

type LlmDownloadModelReq {
	Model string `json:"model"`
}

type LlmDeleteModelReq {
	Model string `json:"model"`
}

// 手机端可下载的本地 GGUF 模型目录（由服务端托管文件，App 下载到本机后离线推理）
type LlmLocalModelCatalogItem {
	Id           string  `json:"id"`
	Name         string  `json:"name"`
	Filename     string  `json:"filename"`
	SizeBytes    int64   `json:"size_bytes"`
	Sha256       string  `json:"sha256"`
	Description  string  `json:"description"`
	ParametersB  float64 `json:"parameters_b"`
	Recommended  bool    `json:"recommended"`
	DownloadPath string  `json:"download_path"`
}

type LlmLocalModelsCatalogResp {
	BaseResp
	Items []LlmLocalModelCatalogItem `json:"items"`
}

// LLM 聊天相关API服务
@server (
	group: llm
)
service Super {
	// 获取可用模型列表
	@handler models
	get /api/llm/models (EmptyReq) returns (LlmModelsResp)

	// 手机离线模型目录（GGUF 由服务端托管，App 下载到本机）
	@handler localModelsCatalog
	get /api/llm/local-models/catalog (EmptyReq) returns (LlmLocalModelsCatalogResp)

	// 创建带有个性化系统提示词的新模型
	@handler createAgent
	post /api/llm/agents (LlmCreateAgentReq) returns (BaseResp)

	// 下载模型
	@handler downloadModel
	post /api/llm/models/download (LlmDownloadModelReq) returns (BaseResp)

	// 删除模型
	@handler deleteModel
	post /api/llm/models/delete (LlmDeleteModelReq) returns (BaseResp)

	// 发送聊天消息
	@handler chat
	post /api/llm/chat (LlmChatReq) returns (LlmChatResp)

	// Ollama 原样转发（终端同款，无服务端记忆注入）
	@handler modelsRaw
	get /api/llm/models/raw (EmptyReq)

	@handler config
	get /api/llm/config (EmptyReq)

	@handler chatRaw
	post /api/llm/chat/raw (EmptyReq)

	@handler showRaw
	post /api/llm/show/raw (EmptyReq)
}

