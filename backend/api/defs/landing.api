// FS-8: landing 域路由（goctl group → api/internal/logic/<group>）
// P6: Production HTTP SSOT → api/landing/v1
// Hybrid-only: @handler routes below feed make gen-api; runtime uses api/moehttp/*_compat.go.
// Do not add new routes here — use api/<domain>/v1/*.proto per new-api-kratos.md.
syntax = "v1"

import "common.api"
@server (
	group: landing
)
service Super {
	@handler submitLandingFeedback
	// P6 migrated → api/landing/v1 (POST /api/landing/feedback)
	post /api/landing/feedback (SubmitLandingFeedbackReq) returns (SubmitLandingFeedbackResp)
}

@server (
	group: ops
)
service Super {
	@handler listLandingFeedback
	// P6 migrated → api/landing/v1 (GET /api/ops/landing/feedback)
	get /api/ops/landing/feedback (ListLandingFeedbackReq) returns (ListLandingFeedbackResp)
}
