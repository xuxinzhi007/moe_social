// FS-8: realtime 域路由（goctl group → api/internal/logic/<group>）
syntax = "v1"

import "common.api"
@server (
	group: voice
	jwt:   Auth
)
service Super {
	@handler getRtcToken
	get /api/voice/token (GetRtcTokenReq) returns (GetRtcTokenResp)

	@handler voiceCall
	post /api/voice/call (VoiceCallReq) returns (VoiceCallResp)

	@handler voiceAnswer
	post /api/voice/answer (VoiceAnswerReq) returns (VoiceAnswerResp)

	@handler voiceReject
	post /api/voice/reject (VoiceRejectReq) returns (BaseResp)

	@handler voiceCancel
	post /api/voice/cancel (VoiceCancelReq) returns (BaseResp)
}

@server (
	group: chat
)
service Super {
	// 查询单个用户在线状态
	@handler chatOnline
	get /api/chat/online (ChatOnlineReq) returns (ChatOnlineResp)

	// 批量查询用户在线状态
	@handler chatOnlineBatch
	get /api/chat/online/batch (ChatOnlineBatchReq) returns (ChatOnlineBatchResp)
}

@server (
	group: chat
)
service Super {
	@doc "WebSocket聊天服务"
	@handler ChatWs
	get /ws/chat

	@doc "WebSocket远程控制服务"
	@handler RemoteWs
	get /ws/remote

	@doc "WebSocket在线状态服务"
	@handler PresenceWs
	get /ws/presence

	@doc "WebSocket大世界同步（房间广播，JSON）"
	@handler WorldWs
	get /ws/world
}
