// FS-8: social 域路由（goctl group → api/internal/logic/<group>）
syntax = "v1"

import "common.api"
// P6: HTTP 契约 SSOT → api/post/v1/post.proto、api/comment/v1/comment.proto（生产走 post_compat.go）
@server (
	group: post
)
service Super {
	@handler getPosts
	get /api/posts (GetPostsReq) returns (GetPostsResp)

	@handler searchPosts
	get /api/posts/search (SearchPostsReq) returns (SearchPostsResp)

	@handler getPost
	get /api/posts/:post_id (GetPostReq) returns (GetPostResp)

	@handler createPost
	post /api/posts (CreatePostReq) returns (CreatePostResp)

	@handler updatePost
	put /api/posts/:post_id (UpdatePostReq) returns (UpdatePostResp)

	@handler deletePost
	delete /api/posts/:post_id (DeletePostReq) returns (DeletePostResp)

	@handler reportPost
	post /api/posts/:post_id/report (ReportPostReq) returns (ReportPostResp)

	@handler likePost
	post /api/posts/:post_id/like (LikePostReq) returns (LikePostResp)

	@handler getPostComments
	get /api/posts/:post_id/comments (GetPostCommentsReq) returns (GetPostCommentsResp)
}

// P6: HTTP 契约 SSOT → api/comment/v1/comment.proto（生产走 comment_compat.go）
@server (
	group: comment
)
service Super {
	@handler createComment
	post /api/comments (CreateCommentReq) returns (CreateCommentResp)

	@handler likeComment
	post /api/comments/:comment_id/like (LikeCommentReq) returns (LikeCommentResp)
}

@server (
	group: content
)
service Super {
	// 生成内容
	@handler generateContent
	post /api/content/generate (ContentGenerationReq) returns (ContentGenerationResp)

	// 获取用户生成的内容列表
	@handler getContentList
	get /api/user/:user_id/content (ContentListReq) returns (ContentListResp)
}

// P6: HTTP 契约 SSOT → api/gift/v1/gift.proto（生产走 gift_compat.go）
@server (
	group: gift
)
service Super {
	// 获取礼物列表
	@handler getGifts
	get /api/gifts (GetGiftsReq) returns (GetGiftsResp)

	// 获取礼物详情
	@handler getGift
	get /api/gifts/:gift_id (GetGiftReq) returns (GetGiftResp)

	// 发送礼物
	@handler sendGift
	post /api/user/:user_id/gifts/send (SendGiftReq) returns (SendGiftResp)

	// 获取用户礼物记录
	@handler getGiftRecords
	get /api/user/:user_id/gifts/records (GetGiftRecordsReq) returns (GetGiftRecordsResp)

	// 礼物购买订单（余额购买进背包）
	@handler getGiftPurchaseOrders
	get /api/user/:user_id/gifts/purchase-orders (GetGiftPurchaseOrdersReq) returns (GetGiftPurchaseOrdersResp)

	// 购买礼物（进入背包）
	@handler purchaseGift
	post /api/user/:user_id/gifts/purchase (PurchaseGiftReq) returns (PurchaseGiftResp)
}

@server (
	group: community
)
service Super {
	// 获取群组列表
	@handler getGroups
	get /api/community/groups (GetGroupsReq) returns (GetGroupsResp)

	// 获取群详情
	@handler getGroup
	get /api/community/groups/:group_id (GetGroupReq) returns (GetGroupResp)

	// 创建群组
	@handler createGroup
	post /api/community/groups (CreateGroupReq) returns (CreateGroupResp)

	// 更新群组信息
	@handler updateGroup
	put /api/community/groups/:group_id (UpdateGroupReq) returns (UpdateGroupResp)

	// 删除群组
	@handler deleteGroup
	delete /api/community/groups/:group_id (DeleteGroupReq) returns (BaseResp)

	// 加入群组
	@handler joinGroup
	post /api/community/groups/:group_id/join (JoinGroupReq) returns (BaseResp)

	// 退出群组
	@handler leaveGroup
	post /api/community/groups/:group_id/leave (LeaveGroupReq) returns (BaseResp)

	// 获取群组成员列表
	@handler getGroupMembers
	get /api/community/groups/:group_id/members (GetGroupMembersReq) returns (GetGroupMembersResp)

	// 获取用户加入的群组
	@handler getUserGroups
	get /api/user/:user_id/community/groups (GetUserGroupsReq) returns (GetUserGroupsResp)

	// 发布群组帖子
	@handler createGroupPost
	post /api/community/groups/:group_id/posts (CreateGroupPostReq) returns (CreateGroupPostResp)

	// 获取群组帖子列表
	@handler getGroupPosts
	get /api/community/groups/:group_id/posts (GetGroupPostsReq) returns (GetGroupPostsResp)
}
