// FS-8b: social 域 RPC（编入 service Super）
  rpc GetPosts(GetPostsReq) returns (GetPostsResp);
  rpc GetPost(GetPostReq) returns (GetPostResp);
  rpc CreatePost(CreatePostReq) returns (CreatePostResp);
  rpc UpdatePost(UpdatePostReq) returns (UpdatePostResp);
  rpc DeletePost(DeletePostReq) returns (DeletePostResp);
  rpc ReportPost(ReportPostReq) returns (ReportPostResp);
  rpc LikePost(LikePostReq) returns (LikePostResp);
  rpc GetPostComments(GetPostCommentsReq) returns (GetPostCommentsResp);
  rpc CreateComment(CreateCommentReq) returns (CreateCommentResp);
  rpc LikeComment(LikeCommentReq) returns (LikeCommentResp);
  rpc CreateGroup(CreateGroupReq) returns (CreateGroupResp);
  rpc GetGroup(GetGroupReq) returns (GetGroupResp);
  rpc GetGroups(GetGroupsReq) returns (GetGroupsResp);
  rpc UpdateGroup(UpdateGroupReq) returns (UpdateGroupResp);
  rpc DeleteGroup(DeleteGroupReq) returns (DeleteGroupResp);
  rpc JoinGroup(JoinGroupReq) returns (JoinGroupResp);
  rpc LeaveGroup(LeaveGroupReq) returns (LeaveGroupResp);
  rpc GetGroupMembers(GetGroupMembersReq) returns (GetGroupMembersResp);
  rpc GetUserGroups(GetUserGroupsReq) returns (GetUserGroupsResp);
  rpc CreateGroupPost(CreateGroupPostReq) returns (CreateGroupPostResp);
  rpc GetGroupPosts(GetGroupPostsReq) returns (GetGroupPostsResp);
  rpc GetGifts(GetGiftsReq) returns (GetGiftsResp);
  rpc GetGift(GetGiftReq) returns (GetGiftResp);
  rpc SendGift(SendGiftReq) returns (SendGiftResp);
  rpc GetGiftRecords(GetGiftRecordsReq) returns (GetGiftRecordsResp);
  rpc PurchaseGift(PurchaseGiftReq) returns (PurchaseGiftResp);
  rpc GetGiftPurchaseOrders(GetGiftPurchaseOrdersReq) returns (GetGiftPurchaseOrdersResp);
