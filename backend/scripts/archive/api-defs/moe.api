// FS-8: moe 域路由（goctl group → api/internal/logic/<group>）
// P6: Production HTTP SSOT → api/moe/v1 (tool execute — optional P6-6c)
// Hybrid-only: @handler routes below feed make gen-api; runtime uses api/moehttp/*_compat.go.
// Do not add new routes here — use api/<domain>/v1/*.proto per new-api-kratos.md.
syntax = "v1"

import "common.api"
@server (
	group: moe
)
service Super {
	@handler getMoeToolsSchema
	// P6 migrated → api/moe/v1 (tool execute — optional P6-6c) (GET /api/moe/tools/schema)
	get /api/moe/tools/schema returns (MoeToolSchemaResp)

	@handler executeMoeTool
	// P6 migrated → api/moe/v1 (tool execute — optional P6-6c) (POST /api/moe/tools/execute)
	post /api/moe/tools/execute (MoeToolExecuteReq) returns (MoeToolExecuteResp)
}
