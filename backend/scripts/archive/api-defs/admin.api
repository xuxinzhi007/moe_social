// FS-8: admin 域路由（goctl group → api/internal/logic/<group>）
// P6: Production HTTP SSOT → api/admin/v1/admin_messages.proto
// Hybrid-only: @handler routes below feed make gen-api; runtime uses api/moehttp/*_compat.go.
// Do not add new routes here — use api/<domain>/v1/*.proto per new-api-kratos.md.
syntax = "v1"

import "common.api"
@server (
	group: admin_public
)
service Super {
	@handler adminLogin
	// P6 migrated → api/admin/v1/admin_messages.proto (POST /api/admin/login)
	post /api/admin/login (AdminLoginReq) returns (AdminLoginResp)

	@handler adminBootstrapAccount
	// P6 migrated → api/admin/v1/admin_messages.proto (POST /api/admin/bootstrap/account)
	post /api/admin/bootstrap/account (EmptyReq) returns (AdminBootstrapAccountResp)
}

@server (
	group: admin
)
